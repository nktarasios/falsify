{# Self-contained report template — inline CSS only, zero external references.
   Spec: docs/SPEC.md RP-1, RP-5. Rendered by core/report.py (PLAN step 2.5). #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --ink:#1a1d21; --muted:#5c6570; --line:#d9dee3; --bg:#ffffff;
          --killed:#8a1f11; --survived:#0b5d1e; --underpowered:#7a5a00; }
  body { font:15px/1.55 -apple-system, "Segoe UI", system-ui, sans-serif;
         color:var(--ink); background:var(--bg); max-width:60rem;
         margin:2rem auto; padding:0 1.25rem; }
  h1,h2,h3 { line-height:1.25; margin:1.6em 0 .5em; }
  h1 { font-size:1.5rem; border-bottom:2px solid var(--ink); padding-bottom:.35rem; }
  h2 { font-size:1.2rem; }
  table { border-collapse:collapse; margin:.75rem 0; width:100%; font-size:.92em; }
  th,td { border:1px solid var(--line); padding:.35rem .55rem; text-align:left;
          vertical-align:top; }
  th { background:#f2f4f6; }
  code, pre { font-family:ui-monospace, Consolas, monospace; font-size:.9em; }
  pre { background:#f6f8fa; border:1px solid var(--line); padding:.7rem;
        overflow-x:auto; }
  blockquote { border-left:3px solid var(--line); margin:.75rem 0;
               padding:.1rem .9rem; color:var(--muted); }
  .verdict-KILLED { color:var(--killed); font-weight:600; }
  .verdict-SURVIVED { color:var(--survived); font-weight:600; }
  .verdict-UNDERPOWERED { color:var(--underpowered); font-weight:600; }
  .guard-pass { color:var(--survived); }
  .guard-warn { color:var(--underpowered); }
  .guard-error { color:var(--killed); font-weight:600; }
  .meta { color:var(--muted); font-size:.85em; }
  .truncated { color:var(--muted); font-style:italic; }
</style>
</head>
<body>
<p class="meta">Falsify Labs · case {{ case }} · generated {{ generated_at }}</p>

{% if verdict_summary %}
<table>
  <tr><th>hypothesis</th><th>verdict</th></tr>
  {% for h in verdict_summary %}
  <tr><td>{{ h.id }}</td><td class="verdict-{{ h.verdict }}">{{ h.verdict }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{{ body }}

<h2>Appendix — queries &amp; guard reports</h2>
{% for q in queries %}
<h3><code>{{ q.name }}</code> <span class="guard-{{ q.guard_status }}">[guard: {{ q.guard_status }}]</span></h3>
<pre>{{ q.sql }}</pre>
<p class="meta">rows: {{ q.row_count }} · result: results/{{ q.result_csv }}
{% if q.failed_checks %} · flagged: {{ q.failed_checks | join(", ") }}{% endif %}</p>
{% endfor %}

<p class="meta">All queries executed read-only via core/db.py. Aggregates only — no
row-level user data (constitution rule 7).</p>
</body>
</html>
